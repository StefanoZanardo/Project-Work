@page "/category"
@using DashBoardTrains.Models
@using DashBoardTrains.Services.CRUDE
@inject IConfiguration config
@inject CategoryService categoryService

<PageTitle>Gestione Categorie Treno</PageTitle>

<div class="container mx-auto px-4 py-8">

    <div class="mb-8 flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-bold text-slate-800">Categorie Treno</h1>
            <p class="text-slate-500">Crea e gestisci le priorità e i nomi delle categorie.</p>
        </div>
    </div>

    <div class="card border-0 shadow-lg rounded-2xl mb-8 overflow-hidden">
        <div class="card-header bg-white border-b border-slate-100 p-4">
            <h5 class="mb-0 text-lg font-semibold text-primary">
                <i class="bi bi-plus-circle me-2"></i> Nuova Categoria
            </h5>
        </div>
        <div class="card-body p-6 bg-slate-50">
            <EditForm Model="@categoria" OnSubmit="InserisciCategoria">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <ValidationSummary class="text-danger small" />
                </div>

                <div class="row g-3 align-items-end">
                    <div class="col-md-6">
                        <label for="categoriaName" class="form-label fw-bold text-slate-700 small uppercase">Nome Identificativo</label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-tag"></i></span>
                            <InputText id="categoriaName"
                                       class="form-control border-start-0 focus:ring-2 focus:ring-blue-500"
                                       @bind-Value="@categoria.trainCategory"
                                       placeholder="Es. Alta Velocità, Regionale..." />
                        </div>
                    </div>

                    <div class="col-md-4">
                        <label for="categoriaPriorità" class="form-label fw-bold text-slate-700 small uppercase">Livello Priorità</label>
                        <div class="input-group shadow-sm">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-sort-numeric-down"></i></span>
                            <InputNumber id="categoriaPriorità"
                                         class="form-control border-start-0"
                                         @bind-Value="@categoria.priorityValue"
                                         placeholder="0" />
                        </div>
                    </div>

                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100 shadow-md hover:shadow-lg transition-all duration-200 py-2 fw-semibold">
                            Salva
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-md overflow-hidden border border-slate-200">
        <div class="p-4 border-b border-slate-100 flex justify-between items-center bg-white">
            <h5 class="mb-0 font-semibold text-slate-700">Lista Categorie Esistenti</h5>
            <span class="badge bg-secondary rounded-pill">  Totale: @categories.Count()</span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle text-center">
                <thead class="bg-slate-100 text-slate-600 uppercase text-xs tracking-wider">
                    <tr>
                        <th class="py-3">ID</th>
                        <th class="py-3 text-start ps-5">Nome Categoria</th>
                        <th class="py-3">Priorità</th>
                        <th class="py-3">Azioni</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in categories)
                    {
                        <tr class="border-b border-slate-50 last:border-0 hover:bg-slate-50 transition-colors">
                            <td class="fw-bold text-slate-500">#@item.categoryId</td>
                            <td class="text-start ps-5 font-medium text-slate-800">
                                @item.trainCategory
                            </td>
                            <td>
                                <span class="badge rounded-pill @(item.priorityValue > 5 ? "bg-warning text-dark" : "bg-info text-white")">
                                    Livello @item.priorityValue
                                </span>
                            </td>
                            <td>
                                <button class="btn btn-outline-danger btn-sm rounded-circle shadow-sm w-8 h-8 flex items-center justify-center mx-auto hover:bg-red-600 hover:text-white transition-all"
                                        title="Elimina @item.trainCategory"
                                        @onclick="() => EliminaCategoria(item.categoryId)">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </td>
                        </tr>
                    }
                    @if (!categories.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-slate-400">
                                <em>Nessuna categoria trovata. Aggiungine una sopra.</em>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>