@page "/trains"
@using DashBoardTrains.Services.CRUDE
@inject IConfiguration config
@inject ServicesGenerics<Train> _serviceTrain
@inject ServicesGenerics<Category> _serviceCategory
@inject NavigationManager NavManager

<PageTitle>Gestione Treni</PageTitle>

<h3>Aggiungi Nuovo Treno</h3>

<EditForm Model="@_train" OnValidSubmit="InserisciTreno">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger mb-3" />

    <div class="row">
        <div class="col-md-6 mb-3">
            <label for="destination" class="form-label">Destinazione</label>
            <InputText id="destination" class="form-control" @bind-Value="@_train.Destination" placeholder="Es. Roma Termini" />
        </div>

        <div class="col-md-6 mb-3">
            <label for="category" class="form-label">Categoria Treno</label>
            <InputSelect id="category" class="form-select" @bind-Value="@_train.CategoryId">
                <option value="">-- Seleziona Categoria --</option>
                @if (_categories != null)
                {
                    @foreach (var cat in _categories)
                    {
                        <option value="@cat.categoryId">@cat.trainCategory</option>
                    }
                }
            </InputSelect>
        </div>

        <div class="col-md-6 mb-3">
            <label for="vagons" class="form-label">Numero Vagoni</label>
            <InputNumber id="vagons" class="form-control" @bind-Value="@_train.Vagons" />
        </div>

        <div class="col-md-6 mb-3">
            <label for="delay" class="form-label">Ritardo (minuti)</label>
            <InputNumber id="delay" class="form-control" @bind-Value="@_train.TimeDelay" />
        </div>

        <div class="col-md-6 mb-3">
            <label for="departure" class="form-label">Data e Ora Partenza</label>
            <InputDate Type="InputDateType.DateTimeLocal" id="departure" class="form-control" @bind-Value="@_train.DepartureTrain" />
        </div>

        <div class="col-md-6 mb-3">
            <label for="arrival" class="form-label">Data e Ora Arrivo</label>
            <InputDate Type="InputDateType.DateTimeLocal" id="arrival" class="form-control" @bind-Value="@_train.ArrivalTrain" />
        </div>
    </div>

    <div class="d-grid gap-2 mt-4">
        <button type="submit" class="btn btn-primary btn-lg">Inserisci Treno</button>
    </div>
</EditForm>