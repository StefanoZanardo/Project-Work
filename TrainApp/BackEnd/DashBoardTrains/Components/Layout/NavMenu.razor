<aside class="app-sidebar">
    <header class="sidebar-brand">
        <a class="sidebar-brand-link" href="/dashboard">
            <span class="sidebar-brand-icon" aria-hidden="true">
                <i class="bi bi-train-front-fill"></i>
            </span>
            <span class="sidebar-brand-text">
                <span class="sidebar-brand-title">TrainApp</span>
                <span class="sidebar-brand-subtitle">Dashboard</span>
            </span>
        </a>
        @* <span class="sidebar-status" role="status">
            <span class="sidebar-status-dot" aria-hidden="true"></span>
            Live
        </span> *@
    </header>

    <input type="checkbox" title="Apri menu di navigazione" class="sidebar-toggler" id="sidebar-nav-toggle" />

    <label class="sidebar-toggler-btn" for="sidebar-nav-toggle" aria-label="Menu navigazione">
        <i class="bi bi-list" aria-hidden="true"></i>
    </label>

    <div class="sidebar-nav-panel nav-scrollable">
        <nav class="sidebar-nav" aria-label="Navigazione principale">
            <p class="nav-section-label">Navigazione</p>

            <div class="nav-item">
                <NavLink class="nav-link" href="dashboard" Match="NavLinkMatch.Prefix"
                         onclick="document.getElementById('sidebar-nav-toggle').checked = false">
                    <span class="nav-link-icon" aria-hidden="true"><i class="bi bi-table"></i></span>
                    <span class="nav-link-text">Tabelle dati treni</span>
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="trains" Match="NavLinkMatch.Prefix"
                         onclick="document.getElementById('sidebar-nav-toggle').checked = false">
                    <span class="nav-link-icon" aria-hidden="true"><i class="bi bi-pencil-square"></i></span>
                    <span class="nav-link-text">Form treni</span>
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="Simulator" Match="NavLinkMatch.Prefix"
                         onclick="document.getElementById('sidebar-nav-toggle').checked = false">
                    <span class="nav-link-icon" aria-hidden="true"><i class="bi bi-play-circle"></i></span>
                    <span class="nav-link-text">Simulatore treni</span>
                </NavLink>
            </div>
        </nav>

        <nav class="sidebar-nav sidebar-nav-footer" aria-label="Account">
            <p class="nav-section-label">Account</p>

            <div class="nav-item">
                <NavLink class="nav-link nav-link-logout" href="login" Match="NavLinkMatch.Prefix"
                         onclick="document.getElementById('sidebar-nav-toggle').checked = false">
                    <span class="nav-link-icon" aria-hidden="true"><i class="bi bi-box-arrow-right"></i></span>
                    <span class="nav-link-text">Esci</span>
                </NavLink>
            </div>
        </nav>
    </div>
</aside>
