@inherits LayoutComponentBase
@inject NavigationManager NavManager

@{
    var isLoginPage = NavManager.Uri.EndsWith("/login", StringComparison.OrdinalIgnoreCase);
}

<div class="page bg-light min-vh-100 d-flex flex-column flex-md-row">
    @if (!isLoginPage)
    {
        <div class="sidebar shadow-sm border-end bg-white">
            <NavMenu />
        </div>
    }

    <main class="flex-fill d-flex flex-column">
        <article class="content px-3 px-md-4 py-3 py-md-4">
            <div class="container-fluid">
                @Body
            </div>
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
